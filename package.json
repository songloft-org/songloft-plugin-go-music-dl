{
  "name": "go-music-dl",
  "version": "2026.9.8",
  "description": "通过 go-music-dl 实例聚合搜索各音源，支持试听、歌词与导入本地库",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && songloft-plugin build",
    "dev": "songloft-plugin dev",
    "validate": "songloft-plugin validate",
    "test": "esbuild src/client.ts --bundle --format=esm --outfile=tests/.gen/client.mjs && esbuild src/bridge-contract.ts --bundle --format=esm --outfile=tests/.gen/contract.mjs && node --test \"tests/*.test.mjs\"",
    "publish:release": "songloft-plugin publish"
  },
  "devDependencies": {
    "@songloft/plugin-builder": "^2.0.0-alpha.1",
    "@songloft/plugin-sdk": "^2.0.0-alpha.1",
    "typescript": "^5.9.3"
  }
}
